  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 10,
      "title": "Guardrails & Compliance Metrics",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 85 },
              { "color": "red", "value": 95 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "(sum(increase(tradepulse_guardrail_evaluations_total{status=\"pass\"}[5m])) / sum(increase(tradepulse_guardrail_evaluations_total[5m]))) * 100",
          "legendFormat": "Pass Rate",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Guardrail Pass Rate (%)",
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      },
      "gridPos": { "h": 8, "w": 10, "x": 6, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (status) (increase(tradepulse_guardrail_evaluations_total[5m]))",
          "legendFormat": "{{status}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Guardrail Evaluation Status (Pass vs Fail)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 1 },
      "id": 3,
      "options": { "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "pieType": "pie" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum by (category) (increase(tradepulse_guardrail_violations_total[1h]))",
          "legendFormat": "{{category}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Guardrail Violations by Category",
      "type": "piechart"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 11,
      "title": "Pipeline Telemetry & Performance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } } },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 10 },
      "id": 4,
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(tradepulse_guardrail_violations_total{category=\"prompt_injection_attempt\"}[24h]))",
          "legendFormat": "Injections Blocked (24h)",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Prompt Injection Attacks Blocked",
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" } } },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 10 },
      "id": 5,
      "options": { "colorMode": "value", "graphMode": "area" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "editorMode": "code",
          "expr": "sum(increase(tradepulse_guardrail_violations_total{category=\"missing_disclaimer\"}[24h]))",
          "legendFormat": "Disclaimers Remediated",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Missing Disclaimers Injected",
      "type": "stat"
    }
  ],
